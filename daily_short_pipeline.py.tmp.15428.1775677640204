# PASO 3: SELECCIONAR MEJOR IDEA
# ═══════════════════════════════════════════════════════════════════════════

def select_best_idea(ideas: list, forced_topic: str = None,
                     used_titles: list = None) -> dict:
    """Selecciona la mejor idea, priorizando categorías con mejor rendimiento
    en el canal y descartando ideas demasiado similares a títulos ya usados."""
    if forced_topic:
        log(f"Usando tema forzado: {forced_topic}", "STEP")
        return {
            "title": forced_topic,
            "category": "General",
            "justification": "Tema seleccionado manualmente por el usuario.",
        }

    if not ideas:
        log("No hay ideas disponibles, usando tema de respaldo", "WARN")
        return {
            "title": "The Most Powerful Earthquake Ever Recorded: Chile 1960",
            "category": "Natural Disasters",
            "justification": "Tema evergreen con alto rendimiento histórico.",
        }

    # ── Filtrar ideas duplicadas contra títulos ya usados ─────────────
    if used_titles:
        filtered = []
        for idea in ideas:
            title = idea.get("title", "")
            is_dup = False
            for used in used_titles:
                if _titles_are_similar(title, used):
                    log(f"  ⛔ Descartada (similar a existente): {title}", "WARN")
                    log(f"       ↳ similar a: {used}")
                    is_dup = True
                    break
            if not is_dup:
                filtered.append(idea)

        if filtered:
            ideas = filtered
            log(f"  {len(ideas)} ideas pasan el filtro de deduplicación", "OK")
        else:
            log("  Todas las ideas son similares a videos existentes. Usando la mejor de todas formas.", "WARN")

    # ── Filtrar ideas duplicadas entre sí (dentro del mismo batch) ────
    unique_ideas = []
    for idea in ideas:
        title = idea.get("title", "")
        is_dup_internal = False
        for accepted in unique_ideas:
            if _titles_are_similar(title, accepted.get("title", "")):
                log(f"  ⛔ Descartada (duplicado interno): {title}", "WARN")
                is_dup_internal = True
                break
        if not is_dup_internal:
            unique_ideas.append(idea)
    ideas = unique_ideas if unique_ideas else ideas

    # Re-rank ideas based on channel performance data
    top_cats = CHANNEL_PERFORMANCE.get("best_performing_categories", [])
    if top_cats:
        cat_scores = {}
        for i, cat in enumerate(top_cats):
            # Higher score for better-performing categories
            cat_scores[cat["name"].lower()] = len(top_cats) - i

        def idea_score(idea):
            cat = idea.get("category", "").lower()
            # Check if the idea's category partially matches any top category
            score = 0
            for cat_name, cat_val in cat_scores.items():
                if cat in cat_name or cat_name in cat:
                    score = cat_val
                    break
            # Bonus for titles with numbers (52% of top performers have them)
            title = idea.get("title", "")
            if any(c.isdigit() for c in title):
                score += 1
            # Bonus for titles with colons (63% of top performers)
            if ":" in title:
                score += 1
            return score

        ideas.sort(key=idea_score, reverse=True)

    best = ideas[0]
    log(f"Idea seleccionada: {best.get('title', 'Sin título')} [{best.get('category', '?')}]", "OK")
    return best


