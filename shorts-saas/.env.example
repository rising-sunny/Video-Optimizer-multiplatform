# ==========================================
# Shorts SaaS - Environment Variables
# Copy to .env and fill in your values
# ==========================================

# App
SECRET_KEY=change-me-to-a-random-string-64-chars
DEBUG=false

# Database
POSTGRES_PASSWORD=shorts_secret
DATABASE_URL=postgresql+asyncpg://shorts:shorts_secret@postgres:5432/shorts

# Redis
REDIS_URL=redis://redis:6379/0

# Media storage (inside Docker)
APP_MEDIA_DIR=/app/media

# Whisper model (base=74MB, small=244MB - use base for 4GB VPS)
WHISPER_MODEL=base

# Default credits for new users
DEFAULT_CREDITS=5

# ==========================================
# AI API Keys (platform-managed)
# ==========================================

# LLM - Script generation
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Image generation
RECRAFT_API_KEY=
FAL_API_KEY=

# TTS (optional - Edge-TTS is free, ElevenLabs is premium)
ELEVENLABS_API_KEY=

# Stock media (optional)
PEXELS_API_KEY=
PIXABAY_API_KEY=
